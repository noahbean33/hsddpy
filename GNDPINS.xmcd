		<region region-id="477" left="204" top="1005" width="98.25" height="12.75" align-x="250.5" align-y="1014" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
