		</region>
		<region region-id="463" left="0" top="440.25" width="439.5" height="12" align-x="0" align-y="450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="true" push-down="true" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<c val="#408080">Integral of flux between wires located at points<sp count="2"/>X and Y, due to flow of 1 amp at position p</c>
				</p>
			</text>
		</region>
		<region region-id="252" left="96" top="469.5" width="138" height="39" align-x="137.25" align-y="492" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="true">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">φ</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">x</ml:id>
							<ml:id xml:space="preserve">y</ml:id>
							<ml:id xml:space="preserve">p</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:integral auto-algorithm="true"/>
						<ml:lambda>
							<ml:boundVars>
								<ml:id xml:space="preserve">v</ml:id>
							</ml:boundVars>
							<ml:apply>
								<ml:mult style="default"/>
								<ml:apply>
									<ml:id xml:space="preserve">dφ</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">v</ml:id>
										<ml:id xml:space="preserve">x</ml:id>
										<ml:id xml:space="preserve">y</ml:id>
										<ml:id xml:space="preserve">p</ml:id>
									</ml:sequence>
								</ml:apply>
								<ml:id xml:space="preserve">L</ml:id>
							</ml:apply>
						</ml:lambda>
						<ml:bounds>
							<ml:id xml:space="preserve">x</ml:id>
							<ml:id xml:space="preserve">y</ml:id>
						</ml:bounds>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="8"/>
		</region>
		<region region-id="314" left="258" top="482.25" width="141" height="24" align-x="258" align-y="492" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<c val="#408080">Where the integration variable, v,</c>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<c val="#408080">traces a path from x to y</c>
				</p>
			</text>
		</region>
		<region region-id="303" left="0" top="530.25" width="439.5" height="60" align-x="0" align-y="540" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="true" push-down="true" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<c val="#408080">Change the flux integration path to first circumscrbe a circle of constant radius about the current source, starting at point x andending at a location nearest to point y. Now complete the integral, moving radially out towards point y. On the circumscribed path, the dot product is always zero, so we get no result. On the radial path, the dot product is always unity. Furthermore, along the radial path the integrand is a function of 1/R, which integrates to log(R). </c>
				</p>
			</text>
		</region>
		<region region-id="305" left="120" top="643.5" width="205.5" height="29.25" align-x="161.25" align-y="660" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">φ</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">x</ml:id>
							<ml:id xml:space="preserve">y</ml:id>
							<ml:id xml:space="preserve">p</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve">μ0</ml:id>
								<ml:apply>
									<ml:mult style="default"/>
									<ml:real>2</ml:real>
									<ml:id xml:space="preserve">π</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">ln</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:absval/>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">y</ml:id>
														<ml:id xml:space="preserve">p</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:id xml:space="preserve">R</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:absval/>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">y</ml:id>
													<ml:id xml:space="preserve">p</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">R</ml:id>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:absval/>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">x</ml:id>
														<ml:id xml:space="preserve">p</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:id xml:space="preserve">R</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:absval/>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">x</ml:id>
													<ml:id xml:space="preserve">p</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">R</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:id xml:space="preserve">L</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="9"/>
		</region>
		<region region-id="637" left="0" top="692.25" width="439.5" height="12" align-x="0" align-y="702" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
