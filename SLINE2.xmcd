			</math>
			<rendering item-idref="9"/>
		</region>
		<region region-id="27" left="6" top="1419.75" width="234" height="12" align-x="6" align-y="1428" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Propagation delay of stripline (s/in.):</p>
			</text>
		</region>
		<region region-id="28" left="60" top="1449" width="125.25" height="18.75" align-x="111.75" align-y="1464" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">PSTRIP</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:real>84.72</ml:real>
							<ml:apply>
								<ml:pow/>
								<ml:real>10</ml:real>
								<ml:real>-12</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:sqrt/>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="10"/>
		</region>
		<region region-id="29" left="294" top="1455.75" width="114" height="36" align-x="294" align-y="1464" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">(same formula for</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit"> centered or offset</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit"> stripline)</p>
			</text>
		</region>
		<region region-id="30" left="6" top="1503.75" width="168" height="12" align-x="6" align-y="1512" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Inductance of stripline (H):</p>
			</text>
		</region>
		<region region-id="31" left="60" top="1527" width="214.5" height="12.75" align-x="137.25" align-y="1536" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">LSTRIP</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">b</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
							<ml:id xml:space="preserve">x</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:apply>
								<ml:id xml:space="preserve">PSTRIP</ml:id>
								<ml:real>1.</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">ZSTRIP</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">t</ml:id>
									<ml:real>1.</ml:real>
								</ml:sequence>
							</ml:apply>
						</ml:apply>
						<ml:id xml:space="preserve">x</ml:id>
