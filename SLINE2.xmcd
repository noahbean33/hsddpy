		<region region-id="32" left="18" top="1563.75" width="240" height="36" align-x="18" align-y="1572" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">In the equation above, we can assume a relative permittivity of 1.; it doesn't </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">affect the answer.</p>
			</text>
		</region>
		<region region-id="33" left="6" top="1623.75" width="210" height="12" align-x="6" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Inductance of offset stripline (H):</p>
			</text>
		</region>
		<region region-id="34" left="42" top="1647" width="267" height="12.75" align-x="144.75" align-y="1656" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">LOSTRIP</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h1</ml:id>
							<ml:id xml:space="preserve">h2</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
							<ml:id xml:space="preserve">x</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:apply>
								<ml:id xml:space="preserve">PSTRIP</ml:id>
								<ml:real>1.</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">ZOFFSET</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">h1</ml:id>
									<ml:id xml:space="preserve">h2</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">t</ml:id>
									<ml:real>1.</ml:real>
