		</region>
		<region region-id="35" left="6" top="1683.75" width="174" height="12" align-x="6" align-y="1692" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Capacitance of stripline (F):</p>
			</text>
		</region>
		<region region-id="36" left="78" top="1700.25" width="183" height="27.75" align-x="168" align-y="1716" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
