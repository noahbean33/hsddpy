			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">INDUCTANCE OF CIRCULAR LOOP</p>
			</text>
		</region>
		<region region-id="16137" left="312" top="3.75" width="114" height="12" align-x="312" align-y="12" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
