		<region region-id="20" left="18" top="951.75" width="270" height="24" align-x="18" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">The impedance, as seen by a 5-ns rising edge,</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">of a 100-nH inductor is 62 <f family="Symbol" charset="2">W</f>.</p>
			</text>
		</region>
		<region region-id="16136" left="156" top="987" width="139.5" height="18.75" align-x="258" align-y="1002" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
