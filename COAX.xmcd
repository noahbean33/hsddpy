			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">ZCOAX</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">d1</ml:id>
							<ml:id xml:space="preserve">d2</ml:id>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:div/>
							<ml:real>60</ml:real>
							<ml:apply>
								<ml:sqrt/>
								<ml:id xml:space="preserve">er</ml:id>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">ln</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve">d2</ml:id>
								<ml:id xml:space="preserve">d1</ml:id>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
