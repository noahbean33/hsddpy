		<region region-id="15" left="6" top="879.75" width="408" height="12" align-x="6" align-y="888" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Composite formula picks skinny or wide model depending on w/h ratio:</p>
			</text>
		</region>
		<region region-id="16" left="18" top="915" width="259.5" height="12.75" align-x="90.75" align-y="924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">E_temp</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:id xml:space="preserve">if</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">w</ml:id>
								<ml:id xml:space="preserve">h</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">E_wide</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">er</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">E_skny</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">er</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="6"/>
		</region>
		<region region-id="17" left="6" top="951.75" width="300" height="12" align-x="6" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Special adjustment to account for trace thickness:</p>
			</text>
		</region>
		<region region-id="18" left="48" top="965.25" width="213.75" height="59.25" align-x="119.25" align-y="996" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">EEFF</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:minus/>
						<ml:apply>
							<ml:id xml:space="preserve">E_temp</ml:id>
							<ml:sequence>
								<ml:id xml:space="preserve">h</ml:id>
								<ml:id xml:space="preserve">w</ml:id>
								<ml:id xml:space="preserve">er</ml:id>
							</ml:sequence>
						</ml:apply>
						<ml:apply>
							<ml:div/>
							<ml:apply>
								<ml:mult style="default"/>
								<ml:parens>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">er</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">t</ml:id>
										<ml:id xml:space="preserve">h</ml:id>
									</ml:apply>
								</ml:parens>
							</ml:apply>
							<ml:apply>
								<ml:mult style="default"/>
								<ml:real>4.6</ml:real>
								<ml:apply>
									<ml:sqrt/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">w</ml:id>
										<ml:id xml:space="preserve">h</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="7"/>
		</region>
		<region region-id="19" left="18" top="1095.75" width="300" height="48" align-x="18" align-y="1104" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">When w/h is skinny, you get the average of the PCB permittivity, er, and the permittivity of air.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">When w/h is wide, (the trace is very close to the</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">ground plane) you get er.</p>
			</text>
		</region>
		<region region-id="21" left="6" top="1251.75" width="216" height="24" align-x="6" align-y="1260" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Effective trace width as a function </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">of other parameters (in.):</p>
			</text>
		</region>
		<region region-id="22" left="18" top="1286.25" width="168" height="12" align-x="18" align-y="1296" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">For skinny traces (2<f family="Symbol" charset="2">p</f>w &lt;<sp count="2"/>h)</p>
			</text>
		</region>
		<region region-id="23" left="60" top="1315.5" width="207" height="29.25" align-x="138" align-y="1332" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">WE_skny</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:plus/>
						<ml:id xml:space="preserve">w</ml:id>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult style="default"/>
									<ml:real>1.25</ml:real>
									<ml:id xml:space="preserve">t</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">π</ml:id>
							</ml:apply>
							<ml:parens>
								<ml:apply>
									<ml:plus/>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">ln</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:mult style="default"/>
												<ml:apply>
													<ml:mult style="default"/>
													<ml:real>4</ml:real>
													<ml:id xml:space="preserve">π</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">w</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">t</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:parens>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="8"/>
		</region>
		<region region-id="24" left="18" top="1382.25" width="150" height="12" align-x="18" align-y="1392" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">For wide traces (2<f family="Symbol" charset="2">p</f>w &gt; h)</p>
			</text>
		</region>
		<region region-id="25" left="60" top="1412.25" width="195.75" height="28.5" align-x="137.25" align-y="1428" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">WE_wide</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:plus/>
						<ml:id xml:space="preserve">w</ml:id>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult style="default"/>
									<ml:real>1.25</ml:real>
									<ml:id xml:space="preserve">t</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">π</ml:id>
							</ml:apply>
							<ml:parens>
								<ml:apply>
									<ml:plus/>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">ln</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:mult style="default"/>
												<ml:real>2</ml:real>
												<ml:id xml:space="preserve">h</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">t</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:parens>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="9"/>
		</region>
		<region region-id="26" left="6" top="1491.75" width="408" height="12" align-x="6" align-y="1500" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Composite formula picks skinny or wide model depending on w/h ratio:</p>
			</text>
		</region>
		<region region-id="27" left="36" top="1520.25" width="265.5" height="28.5" align-x="89.25" align-y="1536" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">WE</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:id xml:space="preserve">if</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">w</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:apply>
										<ml:mult style="default"/>
										<ml:real>2</ml:real>
										<ml:id xml:space="preserve">π</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">WE_wide</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">t</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">WE_skny</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">t</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="10"/>
		</region>
		<region region-id="29" left="6" top="1875.75" width="234" height="24" align-x="6" align-y="1884" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Characteristic impedance as a function </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">of trace geometry (<f family="Symbol" charset="2">W</f>):</p>
			</text>
		</region>
		<region region-id="30" left="6" top="1911.75" width="240" height="24" align-x="6" align-y="1920" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Accuracy of better than 2 percent is </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">obtained under the following conditions:</p>
			</text>
		</region>
		<region region-id="31" left="18" top="1959.75" width="108" height="48" align-x="18" align-y="1968" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<sp count="4"/>0<sp count="2"/>&lt; t/h &lt; 0.2</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<sp count="2"/>0.1<sp count="2"/>&lt; w/h &lt; 20 </p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<sp count="4"/>0<sp count="2"/>&lt;<sp count="2"/>er &lt; 16</p>
			</text>
		</region>
		<region region-id="32" left="18" top="2031.75" width="150" height="12" align-x="18" align-y="2040" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">For skinny traces (w &lt; h)</p>
			</text>
		</region>
		<region region-id="33" left="42" top="2060.25" width="234.75" height="27.75" align-x="125.25" align-y="2076" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">ZMS_skny</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:real>60</ml:real>
						<ml:apply>
							<ml:id xml:space="preserve">ln</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult style="default"/>
										<ml:real>8</ml:real>
										<ml:id xml:space="preserve">h</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">WE</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">h</ml:id>
											<ml:id xml:space="preserve">w</ml:id>
											<ml:id xml:space="preserve">t</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:id xml:space="preserve">WE</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">h</ml:id>
											<ml:id xml:space="preserve">w</ml:id>
											<ml:id xml:space="preserve">t</ml:id>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:mult style="default"/>
										<ml:real>4</ml:real>
										<ml:id xml:space="preserve">h</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="11"/>
		</region>
		<region region-id="34" left="18" top="2139.75" width="138" height="12" align-x="18" align-y="2148" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">For wide traces (w &gt; h)</p>
			</text>
		</region>
		<region region-id="35" left="6" top="2167.5" width="308.25" height="43.5" align-x="88.5" align-y="2184" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">ZMS_wide</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult style="default"/>
							<ml:real>120</ml:real>
							<ml:id xml:space="preserve">π</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:id xml:space="preserve">WE</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">h</ml:id>
											<ml:id xml:space="preserve">w</ml:id>
											<ml:id xml:space="preserve">t</ml:id>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve">h</ml:id>
								</ml:apply>
								<ml:real>1.393</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult style="default"/>
								<ml:real>.667</ml:real>
								<ml:apply>
									<ml:id xml:space="preserve">ln</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">WE</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">h</ml:id>
													<ml:id xml:space="preserve">w</ml:id>
													<ml:id xml:space="preserve">t</ml:id>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">h</ml:id>
										</ml:apply>
										<ml:real>1.444</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="12"/>
		</region>
		<region region-id="36" left="6" top="2271.75" width="408" height="12" align-x="6" align-y="2280" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Composite formula picks skinny or wide model depending on w/h ratio:</p>
			</text>
		</region>
		<region region-id="37" left="12" top="2312.25" width="301.5" height="29.25" align-x="102.75" align-y="2328" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:function>
						<ml:id xml:space="preserve">ZMSTRIP</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">h</ml:id>
							<ml:id xml:space="preserve">w</ml:id>
							<ml:id xml:space="preserve">t</ml:id>
							<ml:id xml:space="preserve">er</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:id xml:space="preserve">if</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:greaterThan/>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">h</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">ZMS_wide</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">h</ml:id>
										<ml:id xml:space="preserve">w</ml:id>
										<ml:id xml:space="preserve">t</ml:id>
									</ml:sequence>
