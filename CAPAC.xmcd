		<region region-id="16155" left="18" top="831.75" width="264" height="24" align-x="18" align-y="840" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<f family="Courier" charset="0">The impedance, as seen by a 5-ns rising edge</f>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
					<f family="Courier" charset="0">of a 100-pF capacitor is 16 </f>
					<f family="Symbol" charset="2">W</f>
					<f family="Courier" charset="0">.</f>
				</p>
			</text>
		</region>
		<region region-id="16156" left="156" top="867" width="145.5" height="18.75" align-x="264" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
