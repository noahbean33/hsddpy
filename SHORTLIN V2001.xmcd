		<region region-id="80" left="222" top="851.25" width="189" height="56.25" align-x="242.25" align-y="888" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math20">
					<ml:apply>
						<ml:indexer/>
						<ml:id xml:space="preserve">S1</ml:id>
						<ml:id xml:space="preserve">k</ml:id>
					</ml:apply>
					<ml:apply>
						<ml:mult style="default"/>
						<ml:apply>
							<ml:id xml:space="preserve">if</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:equal/>
									<ml:id xml:space="preserve">k</ml:id>
									<ml:real>0</ml:real>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve">N</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:minus/>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">e</ml:id>
											<ml:apply>
												<ml:mult style="default"/>
												<ml:apply>
													<ml:mult style="default"/>
													<ml:apply>
														<ml:neg/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">s</ml:id>
															<ml:id xml:space="preserve">k</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve">N</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:id xml:space="preserve">ΔT</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:minus/>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">e</ml:id>
											<ml:apply>
												<ml:mult style="default"/>
												<ml:apply>
													<ml:neg/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">s</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:id xml:space="preserve">ΔT</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:sequence>
						</ml:apply>
						<ml:apply>
							<ml:div/>
							<ml:real>1</ml:real>
